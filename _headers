# Netlify headers (ignored by hosts that don't support this file).

# Content-hashed build output never changes for a given filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate the entry points so deploys reach users promptly.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
/extras/*
  Cache-Control: public, max-age=0, must-revalidate

# 3D models are not content-hashed: cache for a day, then revalidate
# (the service worker also refreshes them in the background).
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
